.joshu/skill-review-state.json
# OSS/self-host metered provider keys written by Connectors (never commit).
.joshu/connectors-providers.env

# Standalone spec repo — https://github.com/db-aeon/portable-soul
portable-soul/

# Docker build staging: keep the marker, ignore staged design-pack contents.
.docker-staging/joshu-design/*
!.docker-staging/joshu-design/.no-design-pack


# On-box boot overlay (hotfix/scripts/.gitkeep is tracked; never commit live patches).
hotfix/scripts/**
!hotfix/scripts/.gitkeep

# Caddyfile is generated at container start from instance.env (see deploy/Caddyfile.template).
deploy/Caddyfile

# Connectors SPA is built to dist/ and rsynced into the live ArozOS template — do not
# commit hashed app bundles dropped into the repo tree by local builds.
arozos/subservice/connectors/app/
arozos/subservice/jterm/app/
arozos/subservice/md-editor/app/
arozos/web-overlays-vanilla/subservice/

# Wrong-path local dev drops (canonical tree is .local/, already ignored above).
local/

# Stray tsc emit — canonical compile output is dist/.
src/**/*.js
src/**/*.js.map

# Voice lock-prompt cache (regenerated by generate-voice-instant-ack scripts).
packages/voice-realtime/.cache/

# Fleet-only local state under proprietary/.
proprietary/.joshu/

# Local vendor checkouts only (gitlinks were removed from the OSS tree; keep clones private).
vendor/arozos/
vendor/excalidraw/

# Copy of the removed last30days engine on an old checkout; never commit it
integrations/last30days-skill/

# Fleet SOP must not live in the AGPL tree (canonical under joshu/docs/Joshu-SOP/).
docs/Joshu-SOP/

# Archify render output (the diagram JSON and SVG live in docs/technical-reference/diagrams/)
.archify/
# taste-skill working files (/design-taste-frontend)
.taste-skill/
