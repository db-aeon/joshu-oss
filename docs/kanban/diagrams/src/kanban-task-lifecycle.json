  "cards": [
    {
      "dot": "cyan",
      "title": "How a task starts",
      "items": [
        "Assignee set and all parents done: ready",
        "A parent not done: todo",
        "triage: true: triage (only project triage roots)",
        "Joshu creates mail tracks and onboarding tasks ready, then blocks them at once through the bridge",
        "Status scheduled exists in Hermes; Joshu does not use it"
      ]
    },
    {
      "dot": "violet",
      "title": "Running ends",
      "items": [
        "kanban_complete: done (bridge complete also needs a comment)",
        "kanban_block with reason and kind: blocked",
        "kanban_block with kind dependency: todo, not blocked",
        "Crash, timeout (max_runtime_seconds, 28800 s on EA boards) or stale claim: back to ready and counted as a failure",
        "After 2 failures in a row (kanban.failure_limit): blocked, event gave_up"
      ]
    },
    {
      "dot": "amber",
      "title": "Blocked",
      "items": [
        "Block kinds: needs_input (owner question), capability, transient, dependency, or none",
        "Unblock comes from an email handoff, an owner reply, the broker after an owner answer, or auto-recovery"
      ]
    },
    {
      "dot": "rose",
      "title": "Joshu patches",
      "items": [
        "Loop breaker: the same block kind twice in a row (BLOCK_RECURRENCE_LIMIT = 2) moves a task to triage",
        "The patch keeps tasks on the 6 EA boards and on every project-* board in blocked (event flag joshu_ea_keep_blocked)",
        "Auto-decompose (triage to todo) is skipped on EA boards; project boards keep it"
      ]
    },
    {
      "dot": "emerald",
      "title": "Bridge actions",
      "items": [
        "reopen: done to ready (realtime-goal follow-up within 48 h)",
        "cancel: stops the worker, comments, archives; works from any status that is not archived"
      ]
    }
  ]
