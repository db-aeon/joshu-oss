  "cards": [
    {
      "dot": "emerald",
      "title": "How a story gets its status",
      "items": [
        "New: no stored story is about the same event",
        "Developing: a stored story matches, and the run found a page or post it did not have",
        "Quiet: a stored story matches, with nothing new; it is in no theme"
      ]
    },
    {
      "dot": "rose",
      "title": "What a failed run does",
      "items": [
        "Sends a short failure note and no partial report update",
        "Leaves stories.json and the period of the next run as they were",
        "A run that Joshu stopped is marked failed at the next start"
      ]
    },
    {
      "dot": "amber",
      "title": "Limits of one run",
      "items": [
        "Collect 2 min, group 90 s, compare 60 s, themes about 5 min, send 60 s",
        "At most two runs at once on one box",
        "A run takes about 5 minutes, and at most 12.5 minutes at the limits"
      ]
    }
  ]
