.joshu/proactive/
.joshu/teams/
.joshu/browser-handoff/
.joshu/sms/
node_modules/
dist/
.next/
*.tsbuildinfo
.local/
.env
.env.*
!.env.example
!deploy/.env.vps.example
!deploy/.env.vps.example.oss
.DS_Store
.pytest_cache/
__pycache__/
*.pyc
