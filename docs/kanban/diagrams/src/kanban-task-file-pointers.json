  "cards": [
    {
      "dot": "cyan",
      "title": "Paths (relative to <files>)",
      "items": [
        "Mail mirror: connectors/mail/<provider>/[<account_key>/]threads/<thread_id>.md (Gmail adds <account_key>)",
        "Triage stub: Triage/<provider>[-<account_key>]-<thread_id>.stub.md; moved to Triage/_done/ when filed",
        "Dedup record: connectors/_state/mail-dedup.json",
        "Meeting sidecar: connectors/_state/meetings/<task_id>.json",
        "Coordination registry: connectors/_state/coordination-active.json"
      ]
    },
    {
      "dot": "emerald",
      "title": "Ingress task fields",
      "items": [
        "Board ea-mail-ingress, body line kind: mail_ingress",
        "source_path points to the mail mirror; account_key names the Gmail account",
        "Task field workspace_path is the files root",
        "Idempotency key: ea-mail-ingress-<message id>"
      ]
    },
    {
      "dot": "slate",
      "title": "Who writes what",
      "items": [
        "Mail sync writes the mail mirror, the triage stub, and the dedup record",
        "The ingress worker files the email in Projects/<slug>/ and creates or hands off the track and meeting tasks through the Connectors MCP",
        "Joshu writes the coordination registry and the meeting sidecar",
        "The dedup record keeps provider, thread_id, and message_id, so the same message does not get a second ingress task"
      ]
    },
    {
      "dot": "violet",
      "title": "Track task fields",
      "items": [
        "Board name: project- + folder slug (projectBoardSlug)",
        "project_slug names Projects/<slug>/; workspace_path is <files>/Projects/<slug>",
        "source_path, the source_paths: list, and each mail_handoff: block point to mail mirrors"
      ]
    },
    {
      "dot": "amber",
      "title": "Project folder",
      "items": [
        "about.md frontmatter: status, urgency, kanban_board, kanban_root_task",
        "todo.md rows and journal_<date>.md entries link the mail as joshu://<source_path>",
        "The ingress worker writes these files (ea-playbook skill)"
      ]
    },
    {
      "dot": "rose",
      "title": "Meeting task and readers",
      "items": [
        "Meeting body: source_paths: list and ingress_handoff: blocks point to mail mirrors",
        "The coordination registry maps a scope id to the open meeting or owner-reply task",
        "The proactive tick reads about.md status and urgency for tasks on project-<slug> boards"
      ]
    }
  ]
