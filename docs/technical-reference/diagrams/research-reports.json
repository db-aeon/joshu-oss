  "cards": [
    {
      "dot": "emerald",
      "title": "How one fact reaches the page",
      "items": [
        "Exa finds a page, and the box reads its text",
        "The model quotes a sentence from it; code keeps the fact only if the quote is on the page",
        "The writer cites it as [F12]; the PDF shows a small number that links to the page"
      ]
    },
    {
      "dot": "rose",
      "title": "What the check removes",
      "items": [
        "A sentence that cites a fact that does not exist",
        "A sentence with a number that is not in a quote it cites",
        "Removed sentences stay in report.json for review (12 in the e-bike run)"
      ]
    },
    {
      "dot": "amber",
      "title": "When little is found",
      "items": [
        "Fewer than 8 facts or fewer than 3 themes: the summary says that little was found",
        "A theme without a fact that passes the check is left out",
        "Charts of coverage over time are in the PDF of a report update, not in a Research report"
      ]
    },
    {
      "dot": "cyan",
      "title": "How a social goal is read",
      "items": [
        "The route cache names the provider endpoint; the shape recipe turns its reply into posts",
        "On a miss, one model call picks the route and one writes the recipe",
        "Hints can add up to three extra goals, for example prediction market odds",
        "HTTP 402: the usage wallet is empty, and the source list says so"
      ]
    }
  ]
